# Sample template for server environment variables
PORT=4000
NODE_ENV=development
APP_VERSION=1.0.0
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRATION=24h

DB_HOST=localhost
DB_PORT=5432
DB_NAME=aws_fullstack_db
DB_USER=postgres
DB_PASS=postgres
DB_POOL_MAX=20

RDS_HOST=your-rds-proxy-endpoint.amazonaws.com
RDS_PORT=5432
RDS_DB=aws_fullstack_db
RDS_USER=app_user
RDS_PASS=your-db-password

AWS_REGION=us-east-1
ORDER_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your-account/order-queue
NOTIFICATION_TOPIC_ARN=arn:aws:sns:us-east-1:your-account:order-topic
